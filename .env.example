# Partner Hub — environment variables
# Copy the values into your host's environment settings (Vercel → Settings →
# Environment Variables) or into a local .env file. Get the values from your
# Supabase project settings (Project URL, anon/publishable key, service_role key).

# --- Browser-side (Vite build-time) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Server-side (server functions) ---
# Use the SAME URL and publishable key as above so one configuration
# works for both the browser and the server.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Keep this secret — never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
